# Publish only the source/configuration roots listed here. New top-level files
# require an explicit review before they can enter a release.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/setup.bat
!/start.bat
!/backend/
!/frontend/
!/scripts/
!/test/

/backend/*
!/backend/app/
!/backend/alembic/
!/backend/tests/
!/backend/requirements.txt
!/backend/alembic.ini
!/backend/pytest.ini

/frontend/*
!/frontend/src/
!/frontend/public/
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/postcss.config.js
!/frontend/tailwind.config.js
!/frontend/tsconfig.json
!/frontend/tsconfig.app.json
!/frontend/tsconfig.node.json
!/frontend/vite.config.ts

/scripts/*
!/scripts/setup.ps1
!/scripts/start.ps1
!/scripts/dev.ps1
!/scripts/dev.cmd

# Only the synthetic-test dependency and its standalone proxy are public.
/test/*
!/test/cdp_app.py
!/test/vite.config.mjs

# Credentials and local environment configuration (at any depth).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
id_rsa*
id_ed25519*
cookies.json
*storage-state*.json
*storage_state*.json

# Candidate documents, databases, browser sessions and runtime output.
storage/
*.session
*.session-journal
*.sqlite*
*.db
*.db-*
*.pdf
*.docx
chrome-profile/
browser-profile/
snapshots/
diagnostics/
generated/

# Python dependencies and generated files.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
*.egg-info/

# Node dependencies and build output.
node_modules/
.npm/
.pnpm-store/
.next/
dist/
build/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Editors and operating systems.
.vs/
.idea/
.vscode/
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary data.
*.log
*.jsonl
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.zip
*.tar*

# Local instructions, private documentation and development transcripts.
AGENTS.md
AGENTS.txt
agents.txt
CLAUDE.md
GEMINI.md
CODEX.md
.codex/
.claude/
.agents/
.aider*
.cursor/
.github/copilot-instructions.md
docs/
*codex*checkpoint*
*agent*transcript*
*agent*memory*
