# Backend
JOBHUNTER_DATABASE_URL=sqlite:///./jobhunter.db
JOBHUNTER_FRONTEND_URL=http://127.0.0.1:5173
JOBHUNTER_BACKEND_URL=http://127.0.0.1:8000
JOBHUNTER_LOG_LEVEL=INFO

# Installed headed Google Chrome managed through loopback CDP.
JOBHUNTER_BROWSER_MODE=cdp
JOBHUNTER_CHROME_PATH=
JOBHUNTER_CHROME_PROFILE=storage/chrome-profile
JOBHUNTER_CDP_HOST=127.0.0.1
JOBHUNTER_BROWSER_AUTOSTART=true
JOBHUNTER_CHALLENGE_TIMEOUT_SECONDS=600
JOBHUNTER_CHALLENGE_POLL_SECONDS=2
JOBHUNTER_COVER_LETTER_MODE=auto
JOBHUNTER_AUTO_ACCEPT_REQUIRED_RECRUITMENT_CONSENTS=false

# AI runtime: api uses Responses API; codex uses a locally authenticated Codex CLI.
AI_RUNTIME=api
AI_RUNTIME_FALLBACK=none
JOBHUNTER_AI_PROVIDER=openai
JOBHUNTER_AI_MODEL=gpt-6-luna
JOBHUNTER_AI_REASONING_EFFORT=low
JOBHUNTER_AI_BATCH_SIZE=15
JOBHUNTER_AI_MAX_OUTPUT_TOKENS=1500
# API mode is deliberately restricted to the official Platform Responses endpoint.
JOBHUNTER_OPENAI_BASE_URL=https://api.openai.com/v1
JOBHUNTER_OPENAI_TIMEOUT_SECONDS=90
JOBHUNTER_OPENAI_MAX_RETRIES=2
JOBHUNTER_CODEX_EXECUTABLE=codex
JOBHUNTER_CODEX_TIMEOUT_SECONDS=180

# Salary policy. Blank fallbacks mean ask the user when no trustworthy minimum exists.
SALARY_STRATEGY=lowest_available
SALARY_EXPERIENCE_TEXT_ENABLED=true
SALARY_FALLBACK_MONTHLY_PLN=
SALARY_FALLBACK_HOURLY_PLN=

# Scanner politeness and diagnostics
JOBHUNTER_SCANNER_CONCURRENCY=2
JOBHUNTER_SCANNER_DELAY_SECONDS=1.2
JOBHUNTER_HTTP_TIMEOUT_SECONDS=25
JOBHUNTER_RAW_HTML_RETENTION_HOURS=24

# Guarded development runs: final actions are blocked in the API and executor.
LIVE_APPLICATION_TEST=false
ALLOW_FINAL_SUBMIT=true

# Keep the private credential in .env, never in this template.
OPENAI_API_KEY=""
